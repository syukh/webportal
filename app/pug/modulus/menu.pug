#menu.css
  .logo
    a(href="https://webportal.com.ua")
      img.logo__img(src="../app/img/site/logo.svg", alt="Logo")
  nav.nav
    -
      let nav = [
        {'src' : 'logo_office.svg', 'alt':'Microsoft Office', 'link':'./office.html'},
        {'src' : 'logo_prog.svg',   'alt':'Програмування', 'link':'./program.html'},
        {'src' : 'logo_web.svg',    'alt':'Web-технології', 'link':'./web.html'},
        {'src' : 'logo_master.svg', 'alt':'Майстер-класи', 'link':'https://webportal.com.ua/'},
      ];
    each element in nav
      a(class="nav__link" href=element.link)
        span.nav__tooltip #{element.alt}
        img(src="../app/img/site/"+element.src)
  
  //- *** Mobile Menu *** -// 
  .icon-bars
    a.icon-bars__link
      i.fa.fa-bars

  .wrap-mobile-menu
    <button class="">
      <i class="fa fa-bars"></i>
    </button>
    .overlay.overlay-scale
      nav.mobile-menu
        ul.mobile-nav
          -
            let course = [
              {'class':'red', 'title':'Microsoft Office', 'link':'./office.html'},
              {'class':'blue', 'title':'Програмування', 'link':'./program.html'},
              {'class':'green', 'title':'Web-технології', 'link':'./web.html'},
              {'class':'orange', 'title':'Майстер-класи', 'link':'https://webportal.com.ua/'},
            ]
          each element in course
            li(class="mobile-nav__item nav-item "+element.class)
              a.nav-item__link(href=element.link) #{element.title}