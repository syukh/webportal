#main-section
  include ../modulus/menu.pug
  #section
    .section-row.section-row__header
      h2.section-title Microsoft Office
      //- h2.section-title Програмування
      //- h2.section-title Web-технології
    .section-row.section-row__course
      .course-wrap#spbar
        -
          let item = [
            //--- SECTION OFFICE  ---// 
            //- {'src':'./img/site/logo_powerpoint.svg', 'name':'PowerPoint', "lesson":"2", "task":"15"},
            {'src':'./app/img/site/logo_excel.svg', 'name':'Excel', "lesson":"14", "task":"55", 'link':'./excel.html'},
            {'src':'./app/img/site/logo_word.svg', 'name':'Word', "lesson":"11", "task":"35", 'link':'./word.html'},
            //--- SECTION PROGRAM  ---// 
            //- {'src':'./app/img/site/logo_pascal.png', 'name':'Pascal-ABC', "lesson":"12", "task":"42", 'link':'./pascal.html'},
            //- {'src':'./app/img/site/logo_python.png', 'name':'Python', "lesson":"10", "task":"49", 'link':'./python.html'},
            //- //--- SECTION WEB ---// 
            //- {'src':'../app/img/site/logo_html.png', 'name':'HTML', "lesson":"11", "task":"23", 'link':'./html.html'},
            //- {'src':'../app/img/site/logo_css.png', 'name':'CSS', "lesson":"6", "task":"7", 'link':'./css.html'},
            //--- SECTION MASTER-CLASS ---//

          ]
        each element in item
          .course-element
            .course-element__item
              .course-element__name.border
                img(src=element.src class="course-element__img")
                a(href=element.link class="name-course") #{element.name}
              .course-element__info.border <span class="element-num">#{element.lesson}</span> уроки
              .course-element__info <span class="element-num">#{element.task}</span> завдання